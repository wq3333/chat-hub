<Window x:Class="ChatHub.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 ChatHub" Height="560" Width="620"
        MinHeight="480" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Icon="/assets/favicon.ico"
        ShowInTaskbar="False"
        Background="#F3F4F6">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A5B4FC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 应用信息 + GitHub 地址 + 当前版本 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="ChatHub" FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Margin="0,4,0,0" Foreground="#6B7280"
                       Text="把常用的 AI 聊天网页收进一个桌面窗口。" />
            <TextBlock Margin="0,14,0,0" Foreground="#374151">
                <Run Text="当前版本：" />
                <Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Margin="0,6,0,0" Foreground="#374151">
                <Run Text="GitHub：" />
                <Hyperlink NavigateUri="{Binding ProjectUrl}" RequestNavigate="OnProjectLinkNavigate">
                    <Run Text="{Binding ProjectUrl, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,14,0,0" />

        <!-- 检查更新 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Left" Style="{StaticResource DialogButton}" MinWidth="96"
                    Content="检查更新" Command="{Binding CheckCommand}"
                    ToolTip="调用 upgrade.bat check 获取 GitHub 最新 release" />
            <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#4B5563" />
        </DockPanel>

        <!-- 有更新时的版本信息与更新入口 -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="14"
                Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Right" Foreground="#9CA3AF" FontSize="11"
                               Text="{Binding LatestPublishedText, StringFormat='发布时间：{0}'}" />
                    <TextBlock FontWeight="SemiBold" Foreground="#111827"
                               Text="{Binding LatestVersionText, StringFormat='最新版本：{0}'}" />
                </DockPanel>

                <TextBlock Grid.Row="1" Text="发布说明" Margin="0,10,0,4" Foreground="#6B7280" />

                <TextBox Grid.Row="2" Text="{Binding LatestNotes, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="#F9FAFB" BorderBrush="#E5E7EB" Padding="8"
                         MinHeight="110" />

                <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="110"
                            Content="立即更新" Command="{Binding UpdateCommand}"
                            ToolTip="下载 win-x64.zip 并重启应用完成更新" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- 下载进度 -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Height="16" Minimum="0" Maximum="100"
                         Value="{Binding DownloadProgress, Mode=OneWay}"
                         Foreground="#2563EB" Background="#E5E7EB" BorderThickness="0" />
            <TextBlock Text="{Binding DownloadStatusText}" Margin="0,6,0,0" Foreground="#6B7280" />
        </StackPanel>

        <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="关闭"
                    Command="{Binding CloseCommand}" />
        </DockPanel>
    </Grid>
</Window>

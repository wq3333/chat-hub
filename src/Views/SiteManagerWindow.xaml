<Window x:Class="ChatHub.Views.SiteManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="站点管理" Height="560" Width="760"
        MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Icon="/assets/favicon.ico"
        ShowInTaskbar="False"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 查询：按名称或网址过滤 -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="查询：" VerticalAlignment="Center" Foreground="#374151" />
            <TextBlock DockPanel.Dock="Right" Text="双击一行可直接修改" VerticalAlignment="Center"
                       Margin="10,0,0,0" Foreground="#9CA3AF" FontSize="11" />
            <TextBox Height="30" VerticalContentAlignment="Center" Padding="6,0"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="输入名称或网址关键字，列表会即时过滤" />
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource DialogButton}" Content="新增" Command="{Binding AddCommand}" />
            <Button Style="{StaticResource DialogButton}" Content="修改" Command="{Binding EditCommand}" />
            <Button Style="{StaticResource DialogButton}" Content="删除" Command="{Binding DeleteCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="SitesGrid"
                  ItemsSource="{Binding SitesView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF0F3"
                  RowHeight="30"
                  Background="#FFFFFF"
                  BorderBrush="#D1D5DB"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="网址" Binding="{Binding Url}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="关闭"
                    IsCancel="True" Command="{Binding CloseCommand}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#6B7280" />
        </DockPanel>
    </Grid>
</Window>
